# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Local defaults to file:local.db; production must use a managed database URL.
DATABASE_URL=file:local.db

# Use a long random value in Render.
JWT_SECRET=replace-with-a-long-random-secret

# AI provider (server-side only)
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
FAST_MODEL=gemini-2.5-flash
REASONING_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Storage and upload limits
STORAGE_PROVIDER=filesystem
STORAGE_ROOT=uploads
MAX_PDF_SIZE=52428800
MAX_AI_INPUT_SIZE=47185920
